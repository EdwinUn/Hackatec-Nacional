# Copia este archivo como backend/.env y ajusta los valores.
# NUNCA subas el .env real al repo.

# ── General ───────────────────────────────
# dev|test = WebSocket sin api_key; otro valor la exige (?api_key=)
ENVIRONMENT=dev
LOG_LEVEL=INFO
# false = logs legibles en consola
LOG_JSON=true

# ── Infraestructura (coincide con compose.yaml) ──
DATABASE_URL=postgresql+asyncpg://hackatec:hackatec@localhost:5432/hackatec
# vacío = broker en memoria (un solo worker, sin Redis)
REDIS_URL=redis://localhost:6379/0

# ── Seguridad / frontend ─────────────────
# separados por coma
CORS_ORIGINS=http://localhost:4200,http://localhost
# header X-API-Key de la ingesta. dev-ingest-key es la llave de desarrollo (la usa el frontend);
# con ENVIRONMENT distinto de dev la API no arranca hasta que pongas una propia
INGEST_API_KEY=dev-ingest-key
# Sesiones del personal (POST /auth/login). ≥ 32 bytes; fuera de dev la API no arranca con el valor por defecto
JWT_SECRET=dev-jwt-secret-solo-para-desarrollo-local
# 720 min = 12 h
JWT_EXPIRES_MIN=720
# intentos de login por IP y por correo en la ventana
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MIN=10
# tope del cuerpo de cualquier petición
MAX_BODY_KB=2048

# ── Reportes ciudadanos y fotos (valores de prototipo) ──
# carpeta de fotos (servida en /media)
MEDIA_DIR=media
MAX_PHOTO_KB=300
# reportes por IP en la ventana
REPORT_RATE_LIMIT=5
REPORT_RATE_WINDOW_MIN=10
# radio para vincular un reporte con la estación más cercana
REPORT_STATION_RADIUS_KM=8

# ── Salud de sensores y alertas (valores de prototipo) ──
SENSOR_OFFLINE_AFTER_MIN=10
SENSOR_DEGRADED_QUALITY=0.6
SENSOR_STUCK_WINDOW=10
HEALTH_SWEEP_INTERVAL_S=60
ALERT_RENOTIFY_AFTER_MIN=15
WS_PING_INTERVAL_S=20

# ── Telemetría de boyas por MQTT ─────────
# vacío = puente apagado (la boya puede usar POST /api/v1/devices/{code}/telemetry)
# Wokwi: el mismo broker público que usa el firmware, ej. mqtt://broker.hivemq.com:1883
# Local: mqtt://localhost:1883 (docker compose up -d mqtt; desde el contenedor api: mqtt://mqtt:1883). TLS: mqtts://usuario:clave@host:8883
MQTT_URL=
# el `+` es el código de la boya (stations.code, ej. RM-01)
MQTT_TOPIC=riomonitor/+/telemetria
# suscripción compartida: con varios workers cada mensaje se ingiere una vez; vacío = normal
MQTT_SHARED_GROUP=rio-api

# ── Simulador dentro de la API ───────────
SIMULATION_ENABLED=false
SIMULATION_INTERVAL_S=5
# SIMULATION_SEED=42

# ── Límites de consultas ─────────────────
MAX_READINGS_PER_REQUEST=1000
MAX_RANGE_DAYS=90
MAX_BUCKETS=5000

# ── Visión artificial (fotos de reportes ciudadanos) ──
# Requiere `uv sync --extra vision` en backend/. Sin el extra, POST /api/v1/vision/analyze responde 503.
VISION_ENABLED=true
# Pesos de YOLO-World (zero-shot); se descargan solos a VISION_MODELS_DIR la primera vez (~25 MB)
VISION_MODEL=yolov8s-worldv2.pt
VISION_MODELS_DIR=models
VISION_CONF=0.15
VISION_IMGSZ=640
# Tope de la foto; la petición completa también pasa por MAX_BODY_KB (súbelo si subes este)
VISION_MAX_IMAGE_MB=2
# Clasificador de escena CLIP que complementa al detector (más fiable para peces muertos y basura)
VISION_SCENE_ENABLED=true
# true = cargar los modelos al arrancar (~12 s, ~1.5 GB de RAM) en vez de en la primera foto
VISION_PRELOAD=false
