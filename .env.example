# Copia este archivo como backend/.env y ajusta los valores.
# NUNCA subas el .env real al repo.

# ── General ───────────────────────────────
# dev|test = WebSocket sin api_key; otro valor la exige (?api_key=)
ENVIRONMENT=dev
LOG_LEVEL=INFO
# false = logs legibles en consola
LOG_JSON=true

# ── Infraestructura (coincide con compose.yaml) ──
DATABASE_URL=postgresql+asyncpg://hackatec:hackatec@localhost:5432/hackatec
# vacío = broker en memoria (un solo worker, sin Redis)
REDIS_URL=redis://localhost:6379/0

# ── Seguridad / frontend ─────────────────
# separados por coma
CORS_ORIGINS=http://localhost:4200
# header X-API-Key de la ingesta
INGEST_API_KEY=cambia-esta-llave

# ── Salud de sensores y alertas (valores de prototipo) ──
SENSOR_OFFLINE_AFTER_MIN=10
SENSOR_DEGRADED_QUALITY=0.6
SENSOR_STUCK_WINDOW=10
HEALTH_SWEEP_INTERVAL_S=60
ALERT_RENOTIFY_AFTER_MIN=15
WS_PING_INTERVAL_S=20

# ── Simulador dentro de la API ───────────
SIMULATION_ENABLED=false
SIMULATION_INTERVAL_S=5
# SIMULATION_SEED=42

# ── Límites de consultas ─────────────────
MAX_READINGS_PER_REQUEST=1000
MAX_RANGE_DAYS=90
MAX_BUCKETS=5000

# ── Visión artificial (fotos de reportes ciudadanos) ──
# Requiere `uv sync --extra vision` en backend/. Sin el extra, POST /api/v1/vision/analyze responde 503.
VISION_ENABLED=true
# Pesos de YOLO-World (zero-shot); se descargan solos a VISION_MODELS_DIR la primera vez (~25 MB)
VISION_MODEL=yolov8s-worldv2.pt
VISION_MODELS_DIR=models
VISION_CONF=0.15
VISION_IMGSZ=640
VISION_MAX_IMAGE_MB=8
# Clasificador de escena CLIP que complementa al detector (más fiable para peces muertos y basura)
VISION_SCENE_ENABLED=true
# true = cargar los modelos al arrancar (~12 s, ~1.5 GB de RAM) en vez de en la primera foto
VISION_PRELOAD=false
